# Managed by Ansible. Secrets are mounted separately from files.
COMPOSE_KOMODO_IMAGE_TAG={{ komodo_image_tag }}
COMPOSE_KOMODO_BACKUPS_PATH={{ komodo_backups_directory }}
TZ={{ timezone }}

KOMODO_HOST={{ komodo_host_url }}
KOMODO_TITLE={{ komodo_title }}
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME={{ komodo_admin_username }}
KOMODO_FIRST_SERVER_NAME={{ komodo_first_server_name }}
KOMODO_DATABASE_USERNAME={{ komodo_database_username }}
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
KOMODO_DISABLE_USER_REGISTRATION={{ komodo_disable_user_registration | bool | ternary('true', 'false') }}
KOMODO_ENABLE_NEW_USERS=false

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS={{ komodo_first_server_name }}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY={{ komodo_root_directory }}
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
{% for key, value in komodo_extra_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}
