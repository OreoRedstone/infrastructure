# Managed by Ansible. Credentials are rendered into this root-only file to
# match the existing Compose deployment and avoid local-secret permission issues.
services:
{% if komodo_deploy_core | bool %}
  mongo:
    image: {{ komodo_mongo_image | to_json }}
    command: --quiet --wiredTigerCacheSizeGB 0.25
    restart: unless-stopped
    labels:
      komodo.skip: ""
      glance.parent: komodo
      glance.name: Mongo
    environment:
{% if komodo_mongo_glibc_tunables | length > 0 %}
      GLIBC_TUNABLES: {{ komodo_mongo_glibc_tunables | to_json }}
{% endif %}
      MONGO_INITDB_ROOT_USERNAME: {{ komodo_database_username | to_json }}
      MONGO_INITDB_ROOT_PASSWORD: {{ vault_komodo_database_password | to_json }}
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb

  core:
    image: ghcr.io/moghtech/komodo-core:{{ komodo_image_tag }}
    init: true
    container_name: {{ komodo_core_container_name }}
    restart: unless-stopped
    labels:
      komodo.skip: "true"
      glance.name: Komodo
      glance.id: komodo
      glance.category: Management
      glance.icon: sh:komodo
      glance.url: {{ komodo_host_url | to_json }}
      glance.description: Docker Stack Management
    depends_on:
      - mongo
{% if komodo_join_nginx_network | bool %}
    networks:
      - default
      - nginx
{% endif %}
{% if komodo_publish_core_port | bool %}
    ports:
{% set additional_bind_addresses = [] %}
{% if komodo_additional_bind_addresses is iterable and komodo_additional_bind_addresses is not string %}
{% set additional_bind_addresses = komodo_additional_bind_addresses %}
{% endif %}
{% for address in [komodo_bind_address] + additional_bind_addresses %}
      - {{ (address ~ ':9120:9120') | to_json }}
{% endfor %}
{% endif %}
    env_file: ./compose.env
    environment:
      KOMODO_DATABASE_ADDRESS: mongo:27017
      KOMODO_DATABASE_USERNAME: {{ komodo_database_username | to_json }}
      KOMODO_DATABASE_PASSWORD: {{ vault_komodo_database_password | to_json }}
      KOMODO_INIT_ADMIN_PASSWORD: {{ vault_komodo_admin_password | to_json }}
      KOMODO_WEBHOOK_SECRET: {{ vault_komodo_webhook_secret | to_json }}
      KOMODO_JWT_SECRET: {{ vault_komodo_jwt_secret | to_json }}
    volumes:
      - keys:/config/keys
      - {{ (komodo_backups_directory ~ ':/backups') | to_json }}
{% endif %}

  periphery:
    image: ghcr.io/moghtech/komodo-periphery:{{ komodo_image_tag }}
    init: true
    restart: unless-stopped
{% if komodo_deploy_core | bool %}
    depends_on:
      - core
{% endif %}
{% if komodo_join_nginx_network | bool %}
    networks:
      - default
{% endif %}
    env_file: ./compose.env
    volumes:
      - keys:/config/keys
      - /var/run/docker.sock:/var/run/docker.sock
      - /proc:/proc
      - {{ (komodo_root_directory ~ ':' ~ komodo_root_directory) | to_json }}

{% if komodo_ntfy_enabled | bool %}
  ntfy-wrapper:
    image: {{ komodo_ntfy_image | to_json }}
    restart: unless-stopped
    env_file:
      - ./ntfy.env
    labels:
      glance.parent: ntfy
      glance.name: Komodo Ntfy Wrapper
{% endif %}

volumes:
  keys:
{% if komodo_deploy_core | bool %}
  mongo-data:
  mongo-config:
{% endif %}
{% if komodo_join_nginx_network | bool %}

networks:
  nginx:
    external: true
    name: {{ komodo_nginx_network_name | to_json }}
{% endif %}
