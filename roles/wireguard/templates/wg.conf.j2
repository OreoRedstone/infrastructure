# Managed by Ansible. Manual changes will be overwritten.
[Interface]
Address = {{ wireguard_address }}
PrivateKey = {{ wireguard_private_key }}
MTU = {{ wireguard_mtu }}
{% if wireguard_is_hub | bool %}
ListenPort = {{ wireguard_port }}
{% endif %}

{% for peer in wireguard_peers %}
# {{ peer.name }}
[Peer]
PublicKey = {{ hostvars[peer.host].wireguard_public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
{% for peer in wireguard_transition_peers %}
# Temporary migration peer: {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
{% for peer in wireguard_external_peers if peer.public_key | default('') | length > 0 %}
# {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
