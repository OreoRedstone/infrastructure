# Managed by Ansible. The VPS forwards public TCP/443 traffic here.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ nginx_reverse_proxy_deploy_server_name }};

    ssl_certificate {{ nginx_reverse_proxy_tls_certificate }};
    ssl_certificate_key {{ nginx_reverse_proxy_tls_certificate_key }};

    location / {
        proxy_pass http://{{ nginx_reverse_proxy_deploy_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        client_max_body_size {{ nginx_reverse_proxy_client_max_body_size }};
        client_body_timeout {{ nginx_reverse_proxy_client_body_timeout }};
        proxy_send_timeout {{ nginx_reverse_proxy_send_timeout }};
        proxy_read_timeout {{ nginx_reverse_proxy_read_timeout }};
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate {{ nginx_reverse_proxy_tls_certificate }};
    ssl_certificate_key {{ nginx_reverse_proxy_tls_certificate_key }};

    location / {
        proxy_pass http://{{ nginx_reverse_proxy_default_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        client_max_body_size {{ nginx_reverse_proxy_client_max_body_size }};
        client_body_timeout {{ nginx_reverse_proxy_client_body_timeout }};
        proxy_send_timeout {{ nginx_reverse_proxy_send_timeout }};
        proxy_read_timeout {{ nginx_reverse_proxy_read_timeout }};
    }
}
