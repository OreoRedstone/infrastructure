# Managed by Ansible. HTTPS terminates here before private upstream routing.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

{% if nginx_reverse_proxy_routes | length > 0 %}
{% for route in nginx_reverse_proxy_routes %}
server {
    listen {{ nginx_reverse_proxy_listen_port }} ssl;
    listen [::]:{{ nginx_reverse_proxy_listen_port }} ssl;
    server_name{% for server_name in route.server_names %} {{ server_name }}{% endfor %};

    ssl_certificate {{ nginx_reverse_proxy_tls_certificate }};
    ssl_certificate_key {{ nginx_reverse_proxy_tls_certificate_key }};

    location / {
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        client_max_body_size {{ route.client_max_body_size | default(nginx_reverse_proxy_client_max_body_size) }};
        client_body_timeout {{ route.client_body_timeout | default(nginx_reverse_proxy_client_body_timeout) }};
        proxy_send_timeout {{ route.send_timeout | default(nginx_reverse_proxy_send_timeout) }};
        proxy_read_timeout {{ route.read_timeout | default(nginx_reverse_proxy_read_timeout) }};
    }
}

{% endfor %}
server {
    listen {{ nginx_reverse_proxy_listen_port }} ssl default_server;
    listen [::]:{{ nginx_reverse_proxy_listen_port }} ssl default_server;
    server_name _;

    ssl_certificate {{ nginx_reverse_proxy_tls_certificate }};
    ssl_certificate_key {{ nginx_reverse_proxy_tls_certificate_key }};

    location / {
        proxy_pass http://{{ nginx_reverse_proxy_default_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        client_max_body_size {{ nginx_reverse_proxy_client_max_body_size }};
        client_body_timeout {{ nginx_reverse_proxy_client_body_timeout }};
        proxy_send_timeout {{ nginx_reverse_proxy_send_timeout }};
        proxy_read_timeout {{ nginx_reverse_proxy_read_timeout }};
    }
}

{% else %}
